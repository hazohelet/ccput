{
 "drop": [
  "libgo.*",
  "libgo-*",
  "libgphobos*",
  "libgdruntime*",
  "libgfortran*",
  "libstdc++*",
  "libsupc++*",
  "libobjc*",
  "libgnat*",
  "libgnarl*",
  "librust*",
  "libgm2*",
  "libcobol*",
  "libga68*",
  "libgrust*",
  "*.la"
 ],
 "families": [
  {
   "name": "gcc-trunk",
   "source_root": "gcc-trunk",
   "driver": "bin/gcc",
   "keep": [
    "bin/",
    "*/bin/",
    "libexec/gcc/*/*/cc1",
    "libexec/gcc/*/*/collect2",
    "libexec/gcc/*/*/lto-wrapper",
    "libexec/gcc/*/*/liblto_plugin.so*",
    "lib/gcc/*/*/*.o",
    "lib/gcc/*/*/lib*",
    "lib/gcc/*/*/include/",
    "lib/gcc/*/*/include-fixed/",
    "lib64/lib*",
    "lib/lib*"
   ]
  },
  {
   "name": "clang-trunk",
   "source_root": "clang-trunk",
   "driver": "bin/clang",
   "keep": [
    "bin/clang",
    "bin/clang++",
    "bin/clang-#",
    "bin/*.cfg",
    "lib/clang/",
    "include/llvm/Support/LICENSE.TXT"
   ]
  },
  {
   "name": "clang-assertions-trunk",
